{
  "name": "@polla/server",
  "version": "0.1.0",
  "description": "Servidor central: poller + normalizador + scoring + endpoint de pronósticos con lock.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed:jugadores": "node scripts/seed-jugadores.mjs",
    "seed:super-admin": "node scripts/seed-super-admin.mjs",
    "seed:smtp": "node scripts/seed-smtp.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "clean:demo": "node scripts/clean-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@polla/core": "workspace:*",
    "@polla/data": "workspace:*",
    "@supabase/supabase-js": "^2.48.1",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
