# ============================================================================
# Variables de entorno — copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` a git (ya está en .gitignore).
# ============================================================================

# --- Supabase (lo obtienes en console: Project Settings → API) ---
# Públicas (van también al frontend, no son secretas):
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=ey...    # clave pública "anon"

# 🔒 SECRETA — solo servidor / Edge Function. Bypasea RLS. Jamás al cliente:
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- Frontend (Vite expone solo las VITE_*) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=ey...
# URL del servidor central. En local: http://localhost:8787
VITE_SERVER_URL=http://localhost:8787

# --- API de fútbol (poller) ---
# 🔒 SECRETO. Regístrate gratis en https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=tu_token_football_data
# Fallback opcional (API-Football / api-sports.io):
API_FOOTBALL_TOKEN=
# TheSportsDB (fotos de jugadores) — clave pública de prueba "3" o la tuya:
THESPORTSDB_KEY=3

# --- Alertas del poller (sección 1): si falla > 5 min ---
# Webhook (Discord/Slack/etc.) o deja vacío para desactivar:
ALERT_WEBHOOK_URL=

# --- SMTP para correos (confirmación/invitación/reset) ---
# 🔒 SECRETO. Se cargan a la tabla config_smtp con `pnpm --filter @polla/server seed:smtp`.
# Con Gmail: una "contraseña de aplicación" (16 caracteres, sin espacios).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=tu_app_password
SMTP_SENDER_EMAIL=tucuenta@gmail.com
SMTP_SENDER_NAME=Polla Mundialista
